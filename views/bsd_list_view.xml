<odoo>
    <record id="bsd_show_list_view" model="ir.ui.view">
        <field name="name">view list</field>
        <field name="model">bsd.tasks</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference" />
                <field name="user_id" />
                <field name="ticket_date" />
                <field name="task_duration" />
                <field name='ticket_done' />
            </list>
        </field>
    </record>
    <record id="bsd_show_graph_view" model="ir.ui.view">
        <field name="name">bsd.show.graph.view</field>
        <field name="model">bsd.tasks</field>
        <field name="arch" type="xml">
            <graph string="Tasks Analysis" type="pie" disable_linking="1" stacked="0">
                <field name="ticket_done" />
                <!-- <field name="task_duration" /> -->
            </graph>
        </field>
    </record>

    <record id="bsd_show_lists" model="ir.actions.act_window">
        <field name="name" >Tasks</field>
        <field name="res_model">bsd.tasks</field>
        <field name="view_mode">list,form,kanban,graph</field>
    </record>
    <menuitem name="Tasks" id="bsd_drop_list" parent="bsd_nav_list" action="bsd_show_lists" />
</odoo>
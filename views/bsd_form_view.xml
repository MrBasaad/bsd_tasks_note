<odoo>
    <record id="bsd_show_form_view" model="ir.ui.view">
        <field name="name">form view</field>
        <field name="model">bsd.tasks</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <field name='ticket_done' widget="statusbar" readonly='1' />
                    </header>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="reference"/>
                            <field name="ticket_date" readonly="1"/>
                            <field name="task_duration"/>
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="Task Line">
                                <field name="line_ids" >
                                    <list editable="bottom" >
                                        <field name="task_prompt"/>
                                        <field name="task_row_is_done"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>    
        </field>
    </record>
</odoo>
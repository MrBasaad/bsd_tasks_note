<odoo>
    <record id="bsd_show_form_views" model="ir.ui.view">
        <field name="name">forms_views</field>
        <field name="model">bsd.tasks</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name='ticket_done' widget="statusbar" readonly='1' />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <widget name="web_ribbon" title="Done" bg_color="text-bg-success"
                        invisible="ticket_done in ('draft','in progres')" />
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="reference" />
                            <field name="ticket_date" readonly="1" />
                            <field name="task_duration" readonly="ticket_done=='done'" />
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="Task Line">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="task_prompt" />
                                        <field name="task_row_is_done" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter class='oe_chatter'>
                    <field name='message_follower_ids' />
                    <field name='activity_ids' />
                    <field name='message_ids' />
                </chatter>
            </form>
        </field>
    </record>
</odoo>